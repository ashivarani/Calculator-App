<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textSize">25sp</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CalcButtonOp" parent="CalcButton">
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
    </style>
        <!-- Base Style for all Calculator Buttons -->
        <style name="CalculatorButtonStyle" parent="Widget.MaterialComponents.Button">
            <item name="android:layout_width">0dp</item>
            <item name="android:layout_height">0dp</item>
            <item name="android:textSize">22sp</item>
            <item name="android:textStyle">bold</item>
            <item name="android:gravity">center</item>
            <item name="android:backgroundTint">@color/number_button_bg</item>
            <item name="android:textColor">@color/number_button_text</item>
            <item name="android:layout_margin">4dp</item>
        </style>

        <!-- Operator Button Style -->
        <style name="CalculatorOperatorButtonStyle" parent="CalculatorButtonStyle">
            <item name="android:backgroundTint">@color/operator_button_bg</item>
            <item name="android:textColor">@color/operator_button_text</item>
        </style>

        <!-- Equal Button Style -->
        <style name="CalculatorEqualButtonStyle" parent="CalculatorButtonStyle">
            <item name="android:backgroundTint">@color/equal_button_bg</item>
            <item name="android:textColor">@color/equal_button_text</item>
        </style>
\

</resources>
