<?xml version="1.0" encoding="utf-8"?>
<androidx.gridlayout.widget.GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:alignmentMode="alignMargins"
    app:columnCount="4"
    app:rowCount="5"
    app:useDefaultMargins="true">

    <!-- Row 0 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/off"
        android:text="OFF"
        android:textColor="@android:color/white"
        android:backgroundTint="#387B99"
        android:textSize="18sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clear"
        android:text="C"
        android:textColor="@android:color/white"
        android:backgroundTint="#387B99"
        android:textSize="18sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/all"
        android:text="AC"
        android:textColor="@android:color/white"
        android:backgroundTint="#387B99"
        android:textSize="18sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/division"
        android:text="/"
        android:textColor="@android:color/white"
        android:backgroundTint="#A2375A"
    android:textSize="18sp"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_columnWeight="1"
    app:layout_rowWeight="1"/>

    <!-- Row 1 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn7"
        android:text="7"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn8"
        android:text="8"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn9"
        android:text="9"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/multiply"
        android:text="×"
        android:textColor="@android:color/white"
        android:backgroundTint="#A2375A"
        android:textSize="18sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <!-- Row 2 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn4"
        android:text="4"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn5"
        android:text="5"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn6"
        android:text="6"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add"
        android:text="+"
        android:textColor="@android:color/white"
        android:backgroundTint="#A2375A"
        android:textSize="18sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <!-- Row 3 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn1"
        android:text="1"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn2"
        android:text="2"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn3"
        android:text="3"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sub"
        android:text="-"
        android:textColor="@android:color/white"
        android:backgroundTint="#A2375A"
        android:textSize="18sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <!-- Row 4 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn0"
        android:text="0"
        android:textColor="@android:color/white"
        android:backgroundTint="#40928A"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnpoint"
        android:text="."
        android:textColor="@android:color/white"
        android:backgroundTint="#387B99"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/equal"
        android:text="="
        android:textColor="@android:color/white"
        android:backgroundTint="#387B99"
    android:textSize="22sp"
    android:textStyle="bold"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_columnWeight="1"
    app:layout_rowWeight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/percent"
        android:text="%"
        android:textColor="@android:color/white"
        android:backgroundTint="#A2375A"
        android:textSize="18sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_columnWeight="1"
        app:layout_rowWeight="1"/>
</androidx.gridlayout.widget.GridLayout>
