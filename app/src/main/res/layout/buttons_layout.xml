<?xml version="1.0" encoding="utf-8"?>
<androidx.gridlayout.widget.GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:alignmentMode="alignMargins"
    app:columnCount="4"
    app:rowCount="5"
    app:useDefaultMargins="true">

    <!-- Row 0 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_off"
        android:text="@string/button_off"
        android:backgroundTint="@color/_387b99"
        android:textSize="18sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_clear"
        android:text="@string/button_clear"
        android:backgroundTint="@color/_387b99"
        android:textSize="18sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_all_clear"
        android:text="@string/button_all_clear"
        android:backgroundTint="@color/_387b99"
        android:textSize="18sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_divide"
        android:text="@string/button_divide"
        android:backgroundTint="@color/a2375a"
        android:textSize="18sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <!-- Row 1 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_7"
        android:text="@string/button_7"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_8"
        android:text="@string/button_8"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_9"
        android:text="@string/button_9"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_multiply"
        android:text="@string/button_multiply"
        android:backgroundTint="@color/a2375a"
        android:textSize="18sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <!-- Row 2 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_4"
        android:text="@string/button_4"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_5"
        android:text="@string/button_5"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_6"
        android:text="@string/button_6"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_add"
        android:text="@string/button_add"
        android:backgroundTint="@color/a2375a"
        android:textSize="18sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <!-- Row 3 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_1"
        android:text="@string/button_1"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_2"
        android:text="@string/button_2"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_3"
        android:text="@string/button_3"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_subtract"
        android:text="@string/button_subtract"
        android:backgroundTint="@color/a2375a"
        android:textSize="18sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <!-- Row 4 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_0"
        android:text="@string/button_0"
        android:backgroundTint="@color/_40928a"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_dot"
        android:text="@string/button_dot"
        android:backgroundTint="@color/_387b99"
        android:textSize="20sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_equal"
        android:text="@string/button_equal"
        android:backgroundTint="@color/_387b99"
        android:textSize="22sp"
        android:textStyle="bold"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_percentage"
        android:text="@string/button_percentage"
        android:backgroundTint="@color/a2375a"
        android:textSize="18sp"
        style="@style/Buttons"
        tools:ignore="VisualLintButtonSize" />

</androidx.gridlayout.widget.GridLayout>
